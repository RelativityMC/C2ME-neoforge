From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ishland <30385023+ishland@users.noreply.github.com>
Date: Fri, 19 Jun 2026 16:13:20 +0800
Subject: [PATCH] Setup publishing


diff --git a/build.gradle b/build.gradle
index 3c8e3163..b9d4e4dc 100644
--- a/build.gradle
+++ b/build.gradle
@@ -274,7 +274,7 @@ apply plugin: 'me.modmuss50.mod-publish-plugin'
 
 publishMods {
     changelog = ghaChangelog
-    modLoaders.add("fabric")
+    modLoaders.add("neoforge")
 
     def envDisplayName = System.getenv("OVERRIDE_DISPLAY_NAME")
     displayName = envDisplayName != null ? envDisplayName : (project.version + " backport devbuild for " + project.minecraft_version)
@@ -306,7 +306,7 @@ publishMods {
 
         curseforge("curseforgeOpenCLAccel") {
             from cfOptions
-            file = project(":c2me-opts-accel-opencl").remapJar.archiveFile
+//            file = project(":c2me-opts-accel-opencl").remapJar.archiveFile
             projectId = "1563823"
             requires("c2me")
             requires("scalablelux")
@@ -323,15 +323,15 @@ publishMods {
         modrinth("modrinthMITPackage") {
             from mrOptions
             file = remapJar.archiveFile
-            projectId = "VSNURh3q"
+            projectId = "COlSi5iR"
         }
 
         modrinth("modrinthOpenCLAccel") {
             from mrOptions
-            file = project(":c2me-opts-accel-opencl").remapJar.archiveFile
+//            file = project(":c2me-opts-accel-opencl").remapWrapperJar.archiveFile
             projectId = "qtPMklut"
             requires {
-                id = "VSNURh3q"
+                id = "COlSi5iR"
             }
             requires {
                 id = "Ps1zyz6x"
diff --git a/c2me-opts-accel-opencl/build.gradle b/c2me-opts-accel-opencl/build.gradle
index 36e71b2e..9ae00cb5 100644
--- a/c2me-opts-accel-opencl/build.gradle
+++ b/c2me-opts-accel-opencl/build.gradle
@@ -105,3 +105,12 @@ def remapWrapperJar = tasks.register("remapWrapperJar", net.fabricmc.loom.task.R
 }
 
 assemble.dependsOn(remapWrapperJar)
+
+rootProject.publishMods {
+    curseforge("curseforgeOpenCLAccel") {
+        file = remapWrapperJar.map { it.archiveFile.get() }
+    }
+    modrinth("modrinthOpenCLAccel") {
+        file = remapWrapperJar.map { it.archiveFile.get() }
+    }
+}
