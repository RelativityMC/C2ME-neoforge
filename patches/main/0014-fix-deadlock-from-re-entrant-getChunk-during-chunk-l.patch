+    /**
+     * @return whether this thread is currently executing a chunk-system task that forbids blocking on a
+     *         re-entrant {@code getChunk} (see {@link RunningWork#isReentrantChunkLoadBarrier()}).
+     */
+    public boolean isExecutingReentrantChunkLoadBarrier() {
+        lock.readLock().lock();
+        try {
+            for (RunningWork work : runningWorks) {
+                if (work.isReentrantChunkLoadBarrier()) {
+                    return true;
+                }
+            }
+            return false;
+        } finally {
+            lock.readLock().unlock();
+        }
+    }
+
