+    private static int syncTestCommand(CommandContext<ServerCommandSource> ctx, int radius, int spacing) {
+        final MinecraftServer server = ctx.getSource().getServer();
+        // Use the server's overworld directly (not the command source's level, which is null on the dedicated console).
+        final ServerWorld world = server.getOverworld();
+        // Random far origin (in chunk coords) so every invocation hits fresh, ungenerated chunks.
+        final int baseX = ThreadLocalRandom.current().nextInt(-1_000_000, 1_000_000);
+        final int baseZ = ThreadLocalRandom.current().nextInt(-1_000_000, 1_000_000);
+        final int side = 2 * radius + 1;
+        final int total = side * side;
+        ctx.getSource().sendFeedback(() -> Text.of(String.format(
+                "[c2me synctest] Synchronously loading %d far chunk(s) around chunk [%d,%d] on the server thread (getChunkBlocking). The server will freeze here if C2ME deadlocks.",
+                total, baseX, baseZ)), true);
+        final long start = System.nanoTime();
+        int loaded = 0;
+        for (int dx = -radius; dx <= radius; dx++) {
+            for (int dz = -radius; dz <= radius; dz++) {
+                final int cx = baseX + dx * spacing;
+                final int cz = baseZ + dz * spacing;
+                world.getChunk(cx, cz, ChunkStatus.FULL, true); // -> getChunkBlocking (synchronous main-thread path)
+                loaded++;
+            }
+        }
+        final long ms = (System.nanoTime() - start) / 1_000_000L;
+        final int loadedF = loaded;
+        ctx.getSource().sendFeedback(() -> Text.of(String.format(
+                "[c2me synctest] Done: %d chunks in %d ms (no deadlock this run).", loadedF, ms)), true);
+        return loadedF;
+    }
