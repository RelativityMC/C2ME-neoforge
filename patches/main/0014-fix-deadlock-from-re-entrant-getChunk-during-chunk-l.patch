+package com.ishland.c2me.base.common.scheduler;
+
+/**
+ * Implemented (via mixin) by the vanilla chunk manager / loading manager when the chunk system rewrite is present.
+ * Lets the {@link SyncLoadStallWatchdog} (which lives in c2me-base and must not depend on the rewrite module)
+ * pull a human-readable dump of a stuck chunk holder's state without a hard module dependency.
+ */
+public interface ISyncLoadDiagnostics {
+
+    /**
+     * @param pos packed chunk position ({@code ChunkPos.toLong})
+     * @return a multi-line, human-readable description of the holder's current scheduler state, or a placeholder
+     *         when no diagnostics are available.
+     */
+    default String c2me$dumpSyncLoadDiagnostics(long pos) {
+        return "(chunk-system rewrite not present; no holder diagnostics)";
+    }
+}
diff --git a/c2me-base/src/main/java/com/ishland/c2me/base/common/scheduler/SyncLoadStallWatchdog.java b/c2me-base/src/main/java/com/ishland/c2me/base/common/scheduler/SyncLoadStallWatchdog.java
new file mode 100644
index 00000000..9d23a52b
--- /dev/null
+++ b/c2me-base/src/main/java/com/ishland/c2me/base/common/scheduler/SyncLoadStallWatchdog.java
@@ -0,0 +1,200 @@
+package com.ishland.c2me.base.common.scheduler;
+
+import net.minecraft.server.world.ServerWorld;
+import net.minecraft.util.math.ChunkPos;
+import net.minecraft.world.chunk.ChunkStatus;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.function.BooleanSupplier;
+
+/**
+ * Diagnostic watchdog for the synchronous, main-thread {@code getChunk}/{@code getChunkBlocking} path.
+ * <p>
+ * When the server thread blocks in {@code MainThreadExecutor.managedBlock(future::isDone)} waiting for an
+ * unloaded chunk, and the wait exceeds a threshold, this watchdog dumps:
+ * <ul>
+ *     <li>the awaited chunk position / requested status / elapsed time,</li>
+ *     <li>the stuck chunk holder's scheduler state (via {@link ISyncLoadDiagnostics}, best-effort), and</li>
+ *     <li>a filtered thread dump of the C2ME worker / scheduler / storage threads and the server thread.</li>
+ * </ul>
+ * This turns the otherwise-silent deadlock (see the deadlock investigation) into the exact artifacts that are
+ * needed to pinpoint which scheduler primitive stalled.
+ * <p>
+ * Enabled by default; the wait threshold is {@code -Dc2me.syncLoadStallThresholdMs} (default 8000). Set it to
+ * {@code 0} (or negative) to disable the watchdog entirely. Overhead is one queue add/remove per sync load.
+ */
+public final class SyncLoadStallWatchdog {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger("C2ME Sync-Load Watchdog");
+
+    private static final long THRESHOLD_NANOS;
+    private static final long REPEAT_NANOS = 10_000_000_000L; // re-dump every 10s while still stalled
+    private static final long POLL_MILLIS = 1_000L;
+
+    static {
+        long ms = Long.getLong("c2me.syncLoadStallThresholdMs", 8_000L);
+        THRESHOLD_NANOS = ms <= 0 ? Long.MAX_VALUE : ms * 1_000_000L;
+    }
+
+    private static final ConcurrentLinkedQueue<Record> ACTIVE = new ConcurrentLinkedQueue<>();
+    private static volatile boolean started = false;
+
+    private SyncLoadStallWatchdog() {
+    }
+
+    public static boolean isEnabled() {
+        return THRESHOLD_NANOS != Long.MAX_VALUE;
+    }
+
+    /**
+     * Register an in-progress synchronous main-thread chunk wait. The returned token MUST be closed
+     * (use try-with-resources) when the wait completes.
+     */
+    public static Token begin(ServerWorld world, ChunkPos pos, ChunkStatus status, boolean create,
+                              BooleanSupplier done, ISyncLoadDiagnostics diagnostics) {
+        if (!isEnabled()) {
+            return NOOP;
+        }
+        ensureStarted();
+        final Record record = new Record(world, pos, status, create, done, diagnostics, System.nanoTime());
+        ACTIVE.add(record);
+        return record;
+    }
+
+    private static void ensureStarted() {
+        if (started) {
+            return;
+        }
+        synchronized (SyncLoadStallWatchdog.class) {
+            if (started) {
+                return;
+            }
+            final Thread thread = new Thread(SyncLoadStallWatchdog::loop, "c2me-syncload-watchdog");
+            thread.setDaemon(true);
+            thread.setPriority(Thread.NORM_PRIORITY + 1);
+            thread.start();
+            started = true;
+        }
+    }
+
+    private static void loop() {
+        while (true) {
+            try {
+                Thread.sleep(POLL_MILLIS);
+            } catch (InterruptedException e) {
+                return;
+            }
+            final long now = System.nanoTime();
+            for (Record record : ACTIVE) {
+                try {
+                    if (record.done.getAsBoolean()) {
+                        continue; // completed but token not yet closed; will be removed shortly
+                    }
+                    final long waited = now - record.startNanos;
+                    if (waited < THRESHOLD_NANOS) {
+                        continue;
+                    }
+                    if (record.dumpedOnce && now - record.lastDumpNanos < REPEAT_NANOS) {
+                        continue;
+                    }
+                    record.dumpedOnce = true;
+                    record.lastDumpNanos = now;
+                    dump(record, waited);
+                } catch (Throwable t) {
+                    LOGGER.error("Error in sync-load watchdog", t);
+                }
+            }
+        }
+    }
+
+    private static void dump(Record record, long waitedNanos) {
+        final StringBuilder sb = new StringBuilder(4096);
+        sb.append('\n');
+        sb.append("================ C2ME SYNCHRONOUS CHUNK LOAD STALL ================\n");
+        sb.append(String.format("Chunk %s in %s has been blocking the server thread for %.1fs (requested status >= %s, create=%s)\n",
+                record.pos, record.world.getRegistryKey().getValue(), waitedNanos / 1.0e9, record.status, record.create));
+        sb.append("This is the synchronous getChunk/getChunkBlocking deadlock if the time keeps growing across dumps.\n");
+
+        sb.append("--- Stuck chunk holder state ---\n");
+        try {
+            final ISyncLoadDiagnostics diag = record.diagnostics;
+            sb.append(diag != null ? diag.c2me$dumpSyncLoadDiagnostics(record.pos.toLong())
+                    : "(no chunk-system diagnostics provider)").append('\n');
+        } catch (Throwable t) {
+            sb.append("(failed to dump holder state: ").append(t).append(")\n");
+        }
+
+        sb.append("--- Thread dump (C2ME scheduler/worker/storage + server threads) ---\n");
+        appendThreadDump(sb);
+
+        sb.append("================ END SYNCHRONOUS CHUNK LOAD STALL ================");
+        LOGGER.error(sb.toString());
+    }
+
+    private static void appendThreadDump(StringBuilder sb) {
+        final Map<Thread, StackTraceElement[]> all = Thread.getAllStackTraces();
+        for (Map.Entry<Thread, StackTraceElement[]> entry : all.entrySet()) {
+            final Thread thread = entry.getKey();
+            final String name = thread.getName();
+            if (!isInteresting(name)) {
+                continue;
+            }
+            sb.append('"').append(name).append("\" #").append(thread.threadId())
+                    .append(' ').append(thread.getState()).append('\n');
+            for (StackTraceElement element : entry.getValue()) {
+                sb.append("\tat ").append(element).append('\n');
+            }
+            sb.append('\n');
+        }
+    }
+
+    private static boolean isInteresting(String name) {
+        if (name == null) {
+            return false;
+        }
+        return name.equals("Server thread")
+                || name.startsWith("c2me-")
+                || name.startsWith("C2ME ")
+                || name.contains("Worker-Main")
+                || name.contains("ForkJoinPool");
+    }
+
+    public interface Token extends AutoCloseable {
+        @Override
+        void close();
+    }
+
+    private static final Token NOOP = () -> {
+    };
+
+    private static final class Record implements Token {
+        final ServerWorld world;
+        final ChunkPos pos;
+        final ChunkStatus status;
+        final boolean create;
+        final BooleanSupplier done;
+        final ISyncLoadDiagnostics diagnostics;
+        final long startNanos;
+        volatile boolean dumpedOnce = false;
+        volatile long lastDumpNanos = 0L;
+
+        Record(ServerWorld world, ChunkPos pos, ChunkStatus status, boolean create,
+               BooleanSupplier done, ISyncLoadDiagnostics diagnostics, long startNanos) {
+            this.world = world;
+            this.pos = pos;
+            this.status = status;
+            this.create = create;
+            this.done = done;
+            this.diagnostics = diagnostics;
+            this.startNanos = startNanos;
+        }
+
+        @Override
+        public void close() {
+            ACTIVE.remove(this);
+        }
+    }
+}
