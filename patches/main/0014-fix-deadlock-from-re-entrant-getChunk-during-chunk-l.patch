+                        sb.append("=> ").append(incomplete).append('/').append(deps.length).append(" deps unsatisfied");
+                    }
+                } catch (Throwable t) {
+                    sb.append("(deps error: ").append(t).append(')');
+                }
+                sb.append('\n');
+            }
+
+            final ChunkState cs = holder.getItem().get();
+            sb.append("  chunkState: ").append(cs == null ? "null"
+                    : ("chunk=" + (cs.chunk() != null ? cs.chunk().getStatus() : "null")
+                       + " reached=" + cs.reachedStatus() + " wasFull=" + cs.wasFullChunk()));
+        } catch (Throwable t) {
+            sb.append("\n(error while dumping holder: ").append(t).append(')');
+        }
+        return sb.toString();
+    }
 }
