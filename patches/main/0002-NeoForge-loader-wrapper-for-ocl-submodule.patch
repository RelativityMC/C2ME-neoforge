+package com.ishland.c2me.gradle;
+
+import net.fabricmc.loom.build.nesting.NestableJarGenerationTask;
+import net.fabricmc.loom.util.FileSystemUtil;
+import org.gradle.api.Action;
+import org.gradle.api.Task;
+import org.gradle.api.file.ConfigurableFileCollection;
+import org.gradle.api.model.ObjectFactory;
+import org.gradle.api.tasks.TaskProvider;
+import org.gradle.workers.WorkAction;
+import org.gradle.workers.WorkParameters;
+import org.gradle.workers.WorkQueue;
+import org.gradle.workers.WorkerExecutor;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import javax.inject.Inject;
+import java.io.File;
+import java.io.IOException;
+import java.io.Serializable;
+import java.io.UncheckedIOException;
+import java.nio.file.Files;
+import java.util.Set;
+
+/**
+ * Configuration-cache-compatible action for nesting jars.
+ * Uses a FileCollection to avoid capturing task references at configuration time.
+ * Do NOT turn me into a record!
+ */
+public abstract class PostProcessNestedJarsAction implements Action<Task>, Serializable {
+
+	@Inject
+	protected abstract WorkerExecutor getWorkerExecutor();
+
+	@Inject
+	protected abstract ObjectFactory getObjectFactory();
+
+	public static void addToTask(NestableJarGenerationTask task) {
+		PostProcessNestedJarsAction postProcessNestedJarsAction = task.getProject().getObjects().newInstance(PostProcessNestedJarsAction.class);
+		task.doLast(postProcessNestedJarsAction);
+	}
+
+	public static void addToTask(TaskProvider<NestableJarGenerationTask> provider) {
+		provider.configure(PostProcessNestedJarsAction::addToTask);
+	}
+
+	@Override
+	public void execute(Task t) {
+		final NestableJarGenerationTask generationTask = (NestableJarGenerationTask) t;
+
+		final WorkQueue workQueue = getWorkerExecutor().noIsolation();
+
+		workQueue.submit(ProcessAction.class, p -> {
+			p.getJars().setFrom(
+					getObjectFactory().fileTree().setDir(generationTask.getOutputDirectory())
+							.matching(pattern -> pattern.include("*.jar"))
+			);
+		});
+	}
+
+	public interface ProcessParameters extends WorkParameters {
+		ConfigurableFileCollection getJars();
+	}
+
+	public abstract static class ProcessAction implements WorkAction<ProcessParameters> {
+		private static final Logger LOGGER = LoggerFactory.getLogger(PostProcessNestedJarsAction.class);
+
+		@Override
+		public void execute() {
+			final Set<File> jars = getParameters().getJars().getFiles();
+
+			if (!jars.isEmpty()) {
+				for (File jar : jars) {
+					try (FileSystemUtil.Delegate fs = FileSystemUtil.getJarFileSystem(jar, false)) {
+						Files.deleteIfExists(fs.getRoot().resolve("META-INF/versions/9/module-info.class"));
+					} catch (IOException e) {
+                        throw new UncheckedIOException(e);
+                    }
+                }
+			}
+		}
+	}
+}
diff --git a/c2me-opts-accel-opencl/build.gradle b/c2me-opts-accel-opencl/build.gradle
index 368e98af..0420087b 100644
--- a/c2me-opts-accel-opencl/build.gradle
