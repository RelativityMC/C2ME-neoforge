@@ -9,6 +9,13 @@ java {
     targetCompatibility = JavaVersion.VERSION_25
 }
 
+sourceSets {
+    wrapper {
+        compileClasspath += sourceSets.main.compileClasspath
+        runtimeClasspath += sourceSets.main.runtimeClasspath
+    }
+}
+
 dependencies {
     include implementation(platform("org.lwjgl:lwjgl-bom:${lwjgl_version}"))
     include implementation("org.lwjgl:lwjgl")
@@ -26,3 +33,51 @@ dependencies {
     include runtimeOnly("org.lwjgl:lwjgl-zstd::natives-linux")
     include runtimeOnly("org.lwjgl:lwjgl-zstd::natives-windows")
 }
+
+com.ishland.c2me.gradle.PostProcessNestedJarsAction.addToTask(tasks.named("processIncludeJars"))
+
+jar {
+    archiveClassifier = "mod-dev"
+}
+
+remapJar {
+    addNestedDependencies = false
+    archiveClassifier = "mod"
+    entryCompression = ZipEntryCompression.STORED
+
+    def metadata = "{\"group\":\"${project.group}\",\"name\":\"${project.name}\",\"version\":\"${project.version}\",\"classifier\":\"\"}"
+
+    doLast {
+        net.fabricmc.loom.util.ZipUtils.add(
+                remapJar.archiveFile.get().getAsFile().toPath(),
+                "META-INF/neo-loom-nesting-metadata.json",
+                metadata
+        )
+    }
+}
+
+def wrapperJar = tasks.register("wrapperJar", Jar) {
+    archiveClassifier = "dev"
+    from(sourceSets.wrapper.output)
+    dependsOn(wrapperClasses)
+}
+
+def remapWrapperJar = tasks.register("remapWrapperJar", net.fabricmc.loom.task.RemapJarTask) {
+    input = wrapperJar.map { it.archiveFile.get() }
+    dependsOn(wrapperJar)
+
+    nestedJars.from(remapJar.archiveFile)
+    nestedJars.builtBy(remapJar)
+    dependsOn(remapJar)
+
+    def processIncludeJars = tasks.named("processIncludeJars", net.fabricmc.loom.build.nesting.NestableJarGenerationTask)
+    nestedJars.from(
+            fileTree(processIncludeJars.flatMap { it.outputDirectory }).matching { it.include("*.jar") }
+    )
+    nestedJars.builtBy(processIncludeJars)
+    dependsOn(processIncludeJars)
+
+    addNestedDependencies = true
+}
+
+assemble.dependsOn(remapWrapperJar)
